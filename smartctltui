def invoking_user():
    """Return (home dir, uid, gid) of the user who started us, even through sudo."""
    name = os.environ.get("SUDO_USER")
    if name and os.geteuid() == 0:
        try:
            p = pwd.getpwnam(name)
            return Path(p.pw_dir), p.pw_uid, p.pw_gid
        except KeyError:
            pass
    return Path.home(), None, None


def reload_after_action(stdscr, st):
    """Fetch fresh data synchronously after an action changed drive state."""
    data, err = run_blocking(stdscr, st, f"Reading {st.drive.name}", lambda: fetch_drive(st.drive))
    if err:
        st.set_status(f"Refresh failed: {err}", "bad")
    else:
        st.data = data


def test_menu(stdscr, st):
    """Offer self-tests and SMART switches for the open drive."""
    d = st.data.json if st.data and st.data.json else {}
    poll = get(d, "ata_smart_data", "self_test", "polling_minutes", default={})
    nvme = is_nvme(d)
    smart_on = get(d, "smart_support", "enabled")
    items = [
        ("Short self-test" + (f" (~{poll['short']} min)" if "short" in poll else ""), "-t short"),
        ("Extended self-test" + (f" (~{poll['extended']} min)" if "extended" in poll else ""), "-t long"),
        ("Conveyance self-test (ATA)" + (f" (~{poll['conveyance']} min)" if "conveyance" in poll else ""), "-t conveyance"),
        ("Immediate offline data collection (ATA)", "-t offline"),
        ("Abort running self-test", "-X"),
        ("Enable SMART", "-s on"),
        ("Disable SMART", "-s off"),
    ]
    enabled = [
        True,
        True,
        "conveyance" in poll,
        is_ata(d) and not nvme,
        True,
        smart_on is False,
        smart_on is True,
    ]
    choice = popup_menu(stdscr, "Tests and actions", [(label, ok) for (label, _), ok in zip(items, enabled)])
    if choice is None:
        return
    label, args = items[choice]
    draw(stdscr, st)
    if args == "-s off" and not popup_confirm(stdscr, "Disable SMART on this drive?"):
        return
    if args in ("-t long", "-t offline") and not popup_confirm(stdscr, f"{label.split(' (')[0]} may slow the drive. Start?"):
        return
    result, err = run_blocking(stdscr, st, label.split(" (")[0], lambda: run_action(st.drive, args.split()))
    ok, msg = (False, str(err)) if err else result
    st.set_status(msg if ok else f"Failed: {msg}", "good" if ok else "bad")
    if ok:
        reload_after_action(stdscr, st)
        st.tab = TABS.index("Self-Tests") if args.startswith("-t") else st.tab


def safe_name(text):
    """Make text safe for use in a filename."""
    return re.sub(r"[^A-Za-z0-9._-]+", "_", text).strip("_") or "drive"


def save_menu(stdscr, st):
    """Save the current tab, full text report, or full JSON to a file."""
    drv = st.drive
    choice = popup_menu(
        stdscr,
        "Save report",
        [(f"Current tab ({TABS[st.tab]}) as text", True), ("Full report as text (smartctl -x)", True), ("Full report as JSON", True)],
    )
    if choice is None:
        return
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    base = f"smartctl_{safe_name(drv.model or drv.name)}_{safe_name(drv.serial)}_{stamp}"
    suffix, ext = [(f"_{safe_name(TABS[st.tab].lower())}", "txt"), ("", "txt"), ("", "json")][choice]
    draw(stdscr, st)
    path_text = popup_text(stdscr, "Save as", str(st.out_dir / f"{base}{suffix}.{ext}"))
    if not path_text:
        return
    path = Path(path_text).expanduser()
    if not path.is_absolute():
        path = st.out_dir / path
    draw(stdscr, st)
    if path.exists() and not popup_confirm(stdscr, f"{path.name} exists. Overwrite?"):
        return
    if choice == 0:
        header = f"{APP_BRAND} - {TABS[st.tab]} - {drv.name} {drv.model} {drv.serial} - {datetime.now():%Y-%m-%d %H:%M:%S}"
        content = "\n".join([header, "=" * len(header), ""] + [t for _, t in st.lines(100)]) + "\n"
    elif choice == 1:
        if st.raw is None:
            raw, err = run_blocking(stdscr, st, "Reading smartctl output", lambda: fetch_raw(drv))
            if err:
                st.set_status(f"Save failed: {err}", "bad")
                return
            st.raw = raw
        content = st.raw
    else:
        if not st.data or st.data.json is None:
            st.set_status("Save failed: no data loaded", "bad")
            return
        content = json.dumps(st.data.json, indent=2) + "\n"
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")
        _, uid, gid = invoking_user()
        if uid is not None:
            os.chown(path, uid, gid)
    except OSError as exc:
        st.set_status(f"Save failed: {exc}", "bad")
        return
    st.set_status(f"Saved {path}", "good")


def open_device(stdscr, st):
    """Prompt for a device path (optionally with ``-d type``) and add it to the list."""
    text = popup_text(stdscr, "Device (e.g. /dev/sdb  or  /dev/sdb -d sat)", "/dev/")
    if not text:
        return
    try:
        tokens = shlex.split(text)
    except ValueError as exc:
        st.set_status(f"Bad input: {exc}", "bad")
        return
    dtype, name = None, None
    it = iter(tokens)
    for tok in it:
        if tok == "-d":
            dtype = next(it, None)
        elif tok.startswith("-d") and len(tok) > 2:
            dtype = tok[2:]
        else:
            name = tok
    if not name:
        return
    drive, err = run_blocking(stdscr, st, f"Probing {name}", lambda: fill_summary(Drive(name, dtype)))
    if err:
        st.set_status(str(err), "bad")
        return
    st.drives.append(drive)
    st.sel = len(st.drives) - 1
    if drive.error:
        st.set_status(f"{name}: {drive.error}", "bad")


def rescan(stdscr, st):
    """Rediscover drives."""
    drives, err = run_blocking(stdscr, st, "Scanning for drives", scan_drives)
    if err:
        st.set_status(f"Scan failed: {err}", "bad")
        return
    st.drives, st.sel = drives, 0


def open_drive(stdscr, st):
    """Enter the tabbed view for the selected drive."""
    st.drive = st.drives[st.sel]
    st.data, st.raw, st.tab, st.scroll, st.cache_key = None, None, 0, {}, ()
    st.view = "drive"
    data, err = run_blocking(stdscr, st, f"Reading {st.drive.name}", lambda: fetch_drive(st.drive))
    st.data = data if not err else DriveData(error=str(err))



def put(win: curses.window, y: int, x: int, text: str, attr: int = 0, maxw: int | None = None) -> None:
    """Call ``addnstr`` without ever raising on edge/overflow.

    Parameters
    ----------
    win : curses.window
        Window to draw into.
    y, x : int
        Target position.
    text : str
        Text to draw.
    attr : int, optional
        Curses attributes.
    maxw : int, optional
        Maximum number of characters to draw.
    """
    h, w = win.getmaxyx()
    if y < 0 or y >= h or x >= w:
        return
    n = (w - x) if maxw is None else min(maxw, w - x)
    try:
        win.addnstr(y, x, text, max(n, 0), attr)
    except curses.error:
        pass


def style_attr(style: str | None) -> int:
    """Map a line style name to a curses attribute.

    Parameters
    ----------
    style : str or None
        Style name.

    Returns
    -------
    int
        Curses attribute value.
    """
    base = ATTRS.get(style, 0) if style else 0
    pair = {"dim": PAIR_DIM, "good": PAIR_GOOD, "bad": PAIR_BAD, "warn": PAIR_WARN}.get(style)
    if pair and style != "dim":
        return base | curses.color_pair(pair)
    return base


def draw_panel_border(win: curses.window, y: int, x: int, height: int, width: int, title: str | None = None) -> None:
    """Draw a rounded box with an optional title embedded in the top edge.

    Parameters
    ----------
    win : curses.window
        Window to draw into.
    y, x : int
        Top-left corner.
    height, width : int
        Box size.
    title : str, optional
        Title shown in the top edge.
    """
    inner = max(width - 2, 0)
    top = (BOX_H + title[: max(inner - 1, 0)]).ljust(inner, BOX_H) if title else BOX_H * inner
    put(win, y, x, BOX_TL + top + BOX_TR, 0, width)
    for row in range(1, height - 1):
        put(win, y + row, x, BOX_V, 0, 1)
        put(win, y + row, x + width - 1, BOX_V, 0, 1)
    put(win, y + height - 1, x, BOX_BL + BOX_H * (width - 2) + BOX_BR, 0, width)


def draw_chrome(win: curses.window, st: AppState, title_right: str | None) -> tuple[int, int]:
    """Draw the title bar, status line and key hint.

    Parameters
    ----------
    win : curses.window
        Window to draw into.
    st : AppState
        Application state.
    title_right : str or None
        Text shown at the right of the title bar.

    Returns
    -------
    height : int
        Window height.
    width : int
        Window width.
    """
    h, w = win.getmaxyx()
    put(win, 0, 1, APP_BRAND, curses.A_BOLD)
    if title_right:
        put(win, 0, max(w - len(title_right) - 1, len(APP_BRAND) + 3), title_right, ATTRS["dim"])
    if st.job:
        frame = SPINNER[int(time.time() * 10) % len(SPINNER)]
        put(win, h - 2, 1, f"{frame} {st.job.message}...", style_attr("warn"))
    elif st.status:
        put(win, h - 2, 1, st.status, style_attr(st.status_style))
    hint = (
        "j/k move  Enter open  o open device  r rescan  ? help  q quit"
        if st.view == "drives"
        else "h/l tabs  j/k gg/G scroll  t tests  s save  r refresh  ? help  q back"
    )
    put(win, h - 1, 1, hint, ATTRS["dim"])
    return h, w


def draw_drives(win: curses.window, st: AppState) -> None:
    """Draw the drive selection list.

    Parameters
    ----------
    win : curses.window
        Window to draw into.
    st : AppState
        Application state.
    """
    h, w = draw_chrome(win, st, "select a drive")
    height = h - 3
    draw_panel_border(win, 1, 0, height, w, "Drives")
    inner_h = height - 2
    if not st.drives:
        put(win, 3, 3, "No drives found. Press o to enter a device manually, r to rescan.", ATTRS["dim"])
        if os.geteuid() != 0 and not os.environ.get("SMARTCTLTUI_SMARTCTL"):
            put(win, 4, 3, "Not running as root - smartctl normally needs root to see drives.", style_attr("warn"))
        return
    st.sel = max(0, min(st.sel, len(st.drives) - 1))
    st.top = max(0, min(st.top, st.sel), st.sel - inner_h + 2)
    cols = (14, 7, 0, 20, 10, 7)
    model_w = max(10, w - 4 - sum(cols) - 5 * 2)
    header = f"{'DEVICE':<14}  {'TYPE':<7}  {'MODEL':<{model_w}}  {'SERIAL':<20}  {'SIZE':>10}  {'HEALTH':<7}"
    put(win, 2, 2, header, ATTRS["dim"])
    for i, drv in enumerate(st.drives[st.top : st.top + inner_h - 1]):
        idx = st.top + i
        health = drv.health or "?"
        model = drv.model if not drv.error else f"({drv.error})"
        row = (
            f"{drv.name:<14}  {(drv.dtype or '-'):<7}  {model[:model_w]:<{model_w}}  "
            f"{drv.serial[:20]:<20}  {human_bytes(drv.size) if drv.size else '-':>10}  "
        )
        attr = curses.A_REVERSE if idx == st.sel else 0
        put(win, 3 + i, 2, row.ljust(w - 4), attr, w - 4)
        hx = 2 + len(row)
        hstyle = "good" if health == "PASSED" else "bad" if health == "FAILED" else "dim"
        put(win, 3 + i, hx, f"{health:<7}", style_attr(hstyle) | attr, w - hx - 1)


def draw_drive(win: curses.window, st: AppState) -> None:
    """Draw the per-drive tabbed view.

    Parameters
    ----------
    win : curses.window
        Window to draw into.
    st : AppState
        Application state.
    """
    drv = st.drive
    title = f"{drv.name}  {drv.model}" if drv.model else drv.name
    h, w = draw_chrome(win, st, title)
    x = 1
    for i, name in enumerate(TABS):
        label = f" {i + 1} {name} "
        put(win, 1, x, label, curses.A_REVERSE if i == st.tab else ATTRS["dim"])
        x += len(label) + 1
    height = h - 4
    draw_panel_border(win, 2, 0, height, w, TABS[st.tab])
    inner_h = height - 2
    st.body_height = inner_h
    lines = st.lines(w - 4)
    top = max(0, min(st.scroll.get(st.tab, 0), len(lines) - inner_h))
    st.scroll[st.tab] = top
    for i, (style, text) in enumerate(lines[top : top + inner_h]):
        put(win, 3 + i, 2, text, style_attr(style), w - 4)
    if len(lines) > inner_h:
        info = f" {top + 1}-{min(top + inner_h, len(lines))}/{len(lines)} "
        put(win, 2 + height - 1, max(w - len(info) - 2, 1), info, ATTRS["dim"])


def draw(win: curses.window, st: AppState) -> None:
    """Redraw the whole screen for the current view.

    Parameters
    ----------
    win : curses.window
        Window to draw into.
    st : AppState
        Application state.
    """
    win.erase()
    (draw_drives if st.view == "drives" else draw_drive)(win, st)
    win.refresh()



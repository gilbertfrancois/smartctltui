def read_key(win: curses.window) -> str | int | None:
    """Read one key.

    Parameters
    ----------
    win : curses.window
        Window to read from.

    Returns
    -------
    str or int or None
        A str for characters, an int for special keys, None on timeout.
    """
    try:
        return win.get_wch()
    except curses.error:
        return None


def is_enter(k: str | int | None) -> bool:
    """Check whether a key is any Enter key.

    Parameters
    ----------
    k : str or int or None
        Key as returned by `read_key`.

    Returns
    -------
    bool
        True for Enter.
    """
    return k in ("\n", "\r", curses.KEY_ENTER)


def popup_box(win: curses.window, title: str, height: int, width: int) -> tuple[int, int]:
    """Clear and frame a centered popup.

    Parameters
    ----------
    win : curses.window
        Window to draw into.
    title : str
        Popup title.
    height, width : int
        Requested size (clamped to the window).

    Returns
    -------
    y : int
        Top row of the popup.
    x : int
        Left column of the popup.
    """
    h, w = win.getmaxyx()
    width, height = min(width, w), min(height, h)
    y, x = max((h - height) // 2, 0), max((w - width) // 2, 0)
    for r in range(height):
        put(win, y + r, x, " " * width, 0, width)
    draw_panel_border(win, y, x, height, width, title)
    return y, x


def popup_menu(win: curses.window, title: str, items: list[tuple[str, bool]]) -> int | None:
    """Show a selectable menu.

    Parameters
    ----------
    win : curses.window
        Window to draw into.
    title : str
        Menu title.
    items : list of tuple
        ``(label, enabled)`` pairs.

    Returns
    -------
    int or None
        Index of the chosen item, or None if cancelled.
    """
    sel = next((i for i, (_, ok) in enumerate(items) if ok), 0)
    width = max(len(label) for label, _ in items) + 8
    win.timeout(-1)
    while True:
        y, x = popup_box(win, title, len(items) + 4, max(width, len(title) + 6))
        for i, (label, ok) in enumerate(items):
            attr = curses.A_REVERSE if i == sel else (0 if ok else ATTRS["dim"])
            put(win, y + 2 + i, x + 2, f" {i + 1} {label}".ljust(width - 4), attr, width - 4)
        win.refresh()
        k = read_key(win)
        if k in ("q", "\x1b"):
            return None
        if k in ("j", curses.KEY_DOWN):
            sel = (sel + 1) % len(items)
        elif k in ("k", curses.KEY_UP):
            sel = (sel - 1) % len(items)
        elif isinstance(k, str) and k.isdigit() and 1 <= int(k) <= len(items) and items[int(k) - 1][1]:
            return int(k) - 1
        elif is_enter(k) and items[sel][1]:
            return sel


def popup_text(win: curses.window, title: str, default: str = "") -> str | None:
    """Show a single-line text editor.

    Parameters
    ----------
    win : curses.window
        Window to draw into.
    title : str
        Prompt title.
    default : str, optional
        Initial text.

    Returns
    -------
    str or None
        The entered text, or None if cancelled.
    """
    h, w = win.getmaxyx()
    width = min(max(w - 8, 20), 100)
    buf, pos = list(default), len(default)
    win.timeout(-1)
    curses.curs_set(1)
    try:
        while True:
            y, x = popup_box(win, title, 5, width)
            field_w = width - 4
            start = max(0, pos - field_w + 1)
            put(win, y + 2, x + 2, "".join(buf)[start : start + field_w], 0, field_w)
            put(win, y + 3, x + 2, "Enter accept   Esc cancel", ATTRS["dim"], field_w)
            win.move(y + 2, x + 2 + pos - start)
            win.refresh()
            k = read_key(win)
            if k == "\x1b":
                return None
            if is_enter(k):
                return "".join(buf).strip()
            if k in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                if pos:
                    del buf[pos - 1]
                    pos -= 1
            elif k == curses.KEY_DC:
                if pos < len(buf):
                    del buf[pos]
            elif k == curses.KEY_LEFT:
                pos = max(0, pos - 1)
            elif k == curses.KEY_RIGHT:
                pos = min(len(buf), pos + 1)
            elif k in (curses.KEY_HOME, "\x01"):
                pos = 0
            elif k in (curses.KEY_END, "\x05"):
                pos = len(buf)
            elif k == "\x15":
                buf, pos = [], 0
            elif isinstance(k, str) and k.isprintable():
                buf.insert(pos, k)
                pos += 1
    finally:
        curses.curs_set(0)


def popup_message(win: curses.window, title: str, lines: list[str], prompt: str = "Press any key") -> str | int:
    """Show a message box and wait for a key.

    Parameters
    ----------
    win : curses.window
        Window to draw into.
    title : str
        Box title.
    lines : list of str
        Message lines.
    prompt : str, optional
        Prompt shown below the message.

    Returns
    -------
    str or int
        The key that dismissed the box.
    """
    width = max(max(len(s) for s in lines), len(prompt), len(title)) + 6
    win.timeout(-1)
    y, x = popup_box(win, title, len(lines) + 5, width)
    for i, text in enumerate(lines):
        put(win, y + 2 + i, x + 2, text, 0, width - 4)
    put(win, y + len(lines) + 3, x + 2, prompt, ATTRS["dim"], width - 4)
    win.refresh()
    while True:
        k = read_key(win)
        if k is not None and k != curses.KEY_RESIZE:
            return k


def popup_confirm(win: curses.window, message: str) -> bool:
    """Ask a yes/no question.

    Parameters
    ----------
    win : curses.window
        Window to draw into.
    message : str
        Question to show.

    Returns
    -------
    bool
        True if the user pressed ``y``.
    """
    return popup_message(win, "Confirm", [message], "y = yes, any other key = no") in ("y", "Y")



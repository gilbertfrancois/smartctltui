def build_advanced(d, _width):
    """Advanced: smartctl diagnostics plus every section not shown elsewhere."""
    lines = []
    section(lines, "smartctl")
    ver = get(d, "smartctl", "version", default=[])
    kv(lines, "Version", ".".join(map(str, ver)))
    kv(lines, "Platform", get(d, "smartctl", "platform_info"))
    status = get(d, "smartctl", "exit_status", default=0)
    kv(lines, "Exit status", f"{status} (0b{status:08b})")
    for bit, (style, text) in EXIT_BITS.items():
        if status & (1 << bit):
            lines.append((style, f"  bit {bit}: {text}"))
    for msg in messages_of(d):
        lines.append(("warn", f"  message: {msg}"))
    vendor = d.get("nvme_pci_vendor")
    if vendor:
        section(lines, "NVMe PCI identity")
        kv_flat(lines, {"nvme_pci_vendor": vendor, "ieee_oui": d.get("nvme_ieee_oui_identifier")})
    for key in sorted(k for k in d if k not in HANDLED_KEYS):
        section(lines, key)
        kv_flat(lines, d[key], indent="  ")
    return lines


def build_raw(text, _width):
    """Raw: the unmodified text output of ``smartctl -x``."""
    if text is None:
        return [("dim", "Loading smartctl output...")]
    return [("head" if line.startswith("===") else None, line) for line in text.splitlines()]



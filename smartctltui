def handle_drives_key(stdscr, st, k):
    """Handle a key in the drive list; return False to quit."""
    g, st.pending_g = st.pending_g, False
    n = len(st.drives)
    if k in ("q", "\x1b"):
        return False
    if k in ("j", curses.KEY_DOWN) and n:
        st.sel = min(st.sel + 1, n - 1)
    elif k in ("k", curses.KEY_UP):
        st.sel = max(st.sel - 1, 0)
    elif k == "g":
        if g:
            st.sel = 0
        else:
            st.pending_g = True
    elif k == "G" and n:
        st.sel = n - 1
    elif is_enter(k) and n:
        open_drive(stdscr, st)
    elif k == "o":
        open_device(stdscr, st)
    elif k == "r":
        rescan(stdscr, st)
    elif k == "?":
        popup_message(stdscr, "Help", HELP_LINES)
    return True


def handle_drive_key(stdscr, st, k):
    """Handle a key in the drive view."""
    g, st.pending_g = st.pending_g, False
    page = max(st.body_height - 1, 1)
    scroll = st.scroll.get(st.tab, 0)
    last = max(len(st.lines(100)) - st.body_height, 0)
    if k in ("q", "\x1b"):
        st.view, st.job = "drives", None
        return
    new_tab = None
    if k in ("l", curses.KEY_RIGHT, "\t"):
        new_tab = (st.tab + 1) % len(TABS)
    elif k in ("h", curses.KEY_LEFT, curses.KEY_BTAB):
        new_tab = (st.tab - 1) % len(TABS)
    elif isinstance(k, str) and k.isdigit() and 1 <= int(k) <= len(TABS):
        new_tab = int(k) - 1
    if new_tab is not None:
        st.tab = new_tab
        if st.tab == RAW_TAB and st.raw is None and not st.job:
            drv = st.drive
            st.job = Job(
                "Reading smartctl output",
                lambda: fetch_raw(drv),
                lambda job: setattr(st, "raw", job.result if not job.error else f"Error: {job.error}"),
            )
        return
    if k in ("j", curses.KEY_DOWN):
        scroll += 1
    elif k in ("k", curses.KEY_UP):
        scroll -= 1
    elif k in ("\x04", curses.KEY_NPAGE, " "):
        scroll += page
    elif k in ("\x15", curses.KEY_PPAGE, "b"):
        scroll -= page
    elif k == "g":
        if g:
            scroll = 0
        else:
            st.pending_g = True
    elif k == "G":
        scroll = last
    elif k == "r":
        start_refresh(st)
    elif k == "t":
        test_menu(stdscr, st)
    elif k == "s":
        save_menu(stdscr, st)
    elif k == "?":
        popup_message(stdscr, "Help", HELP_LINES)
    st.scroll[st.tab] = max(0, min(scroll, last))


def init_colors():
    """Follow the terminal theme; add green/yellow/red for status only."""
    try:
        curses.start_color()
        curses.use_default_colors()
        dim = COLOR_BRIGHT_BLACK if curses.COLORS >= 16 else curses.COLOR_BLACK
        curses.init_pair(PAIR_DIM, dim, -1)
        curses.init_pair(PAIR_GOOD, curses.COLOR_GREEN, -1)
        curses.init_pair(PAIR_BAD, curses.COLOR_RED, -1)
        curses.init_pair(PAIR_WARN, curses.COLOR_YELLOW, -1)
        ATTRS["dim"] = curses.color_pair(PAIR_DIM) | (curses.A_BOLD if curses.COLORS < 16 else 0)
    except curses.error:
        pass


def main(stdscr, out_dir):
    """Run the app's main event loop."""
    init_colors()
    curses.curs_set(0)
    stdscr.keypad(True)
    st = AppState(out_dir=out_dir)
    rescan(stdscr, st)
    running = True
    while running:
        tick(st)
        draw(stdscr, st)
        stdscr.timeout(150)
        k = read_key(stdscr)
        if k is None or k == curses.KEY_RESIZE:
            continue
        if st.view == "drives":
            running = handle_drives_key(stdscr, st, k)
        else:
            handle_drive_key(stdscr, st, k)


def ensure_root(argv):
    """Re-run under sudo when not root (smartctl needs it to open drives)."""
    if os.geteuid() == 0 or os.environ.get("SMARTCTLTUI_SMARTCTL"):
        return
    if shutil.which("sudo") is None:
        print("Warning: not running as root and sudo not found; drives may be inaccessible.", file=sys.stderr)
        return
    print("smartctl needs root to access drives; re-running with sudo...", file=sys.stderr)
    os.execvp("sudo", ["sudo", sys.executable, os.path.abspath(__file__)] + argv)


if __name__ == "__main__":
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")

    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--version", action="version", version=APP_BRAND)
    parser.add_argument("--no-sudo", action="store_true", help="do not re-run under sudo when not root")
    parser.add_argument("--output-dir", type=Path, default=None, help="default directory for saved reports (default: home)")
    args = parser.parse_args()

    if shutil.which(SMARTCTL_CMD[0]) is None:
        print("Required tool not found: smartctl (install the smartmontools package)", file=sys.stderr)
        sys.exit(1)
    if not args.no_sudo:
        ensure_root(sys.argv[1:])

    setup_glyphs()
    try:
        curses.wrapper(main, (args.output_dir or invoking_user()[0]).expanduser())
    except KeyboardInterrupt:
        pass

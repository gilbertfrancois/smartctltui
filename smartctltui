@dataclass
class Drive:
    """A drive known to the app, plus the summary shown in the drive list.

    Attributes
    ----------
    name : str
        Device node, e.g. ``/dev/sda``.
    dtype : str or None
        smartctl device type passed with ``-d``, if any.
    model : str
        Model name.
    serial : str
        Serial number.
    size : int
        Capacity in bytes (0 if unknown).
    health : str or None
        ``"PASSED"``, ``"FAILED"`` or None when unknown.
    error : str or None
        Reason the drive could not be queried, if any.
    """

    name: str
    dtype: str | None = None
    model: str = ""
    serial: str = ""
    size: int = 0
    health: str | None = None
    error: str | None = None

    def args(self) -> list[str]:
        """Return the smartctl arguments that address this drive.

        Returns
        -------
        list of str
            Device selection arguments, including ``-d <type>`` when set.
        """
        return ["-d", self.dtype, self.name] if self.dtype else [self.name]


@dataclass
class DriveData:
    """Result of one full smartctl query of a drive.

    Attributes
    ----------
    json : dict or None
        Parsed smartctl JSON document, or None on failure.
    error : str or None
        Failure description when ``json`` is None.
    fetched : float
        Unix timestamp of when the data was fetched.
    """

    json: dict | None = None
    error: str | None = None
    fetched: float = field(default_factory=time.time)


def smartctl_json(args: list[str], timeout: float = FETCH_TIMEOUT) -> tuple[dict | None, subprocess.CompletedProcess]:
    """Run ``smartctl -j <args>`` and parse its JSON output.

    smartctl signals warnings through exit-status bits while still emitting
    valid JSON, so the output is parsed regardless of the return code.

    Parameters
    ----------
    args : list of str
        Arguments to pass to smartctl (after ``-j``).
    timeout : float, optional
        Timeout in seconds for the subprocess.

    Returns
    -------
    data : dict or None
        Parsed JSON, or None if the output was not valid JSON.
    proc : subprocess.CompletedProcess
        The finished process.
    """
    proc = subprocess.run(SMARTCTL_CMD + ["-j"] + args, capture_output=True, text=True, timeout=timeout, check=False)
    try:
        data = json.loads(proc.stdout)
    except ValueError:
        data = None
    return data, proc


def messages_of(data: dict) -> list[str]:
    """Return the smartctl messages of a JSON document.

    Parameters
    ----------
    data : dict
        Parsed smartctl JSON.

    Returns
    -------
    list of str
        Message strings (possibly empty).
    """
    return [m.get("string", "") for m in get(data, "smartctl", "messages", default=[]) if isinstance(m, dict)]


def failure_text(data: dict | None, proc: subprocess.CompletedProcess) -> str:
    """Explain why a smartctl call produced no usable information.

    Parameters
    ----------
    data : dict or None
        Parsed smartctl JSON, if any.
    proc : subprocess.CompletedProcess
        The finished smartctl process.

    Returns
    -------
    str
        Human-readable failure description.
    """
    msgs = messages_of(data) if data else []
    if msgs:
        return "; ".join(msgs)
    return (proc.stderr or proc.stdout or f"smartctl exited with status {proc.returncode}").strip()


def fill_summary(drive: Drive) -> Drive:
    """Populate a drive's list-view fields from ``smartctl -i -H``.

    Parameters
    ----------
    drive : Drive
        Drive to update in place.

    Returns
    -------
    Drive
        The same drive, with summary fields or ``error`` set.
    """
    try:
        data, proc = smartctl_json(["-i", "-H"] + drive.args(), timeout=60)
    except (OSError, subprocess.SubprocessError) as exc:
        drive.error = str(exc)
        return drive
    if not data or "device" not in data and "model_name" not in data and "scsi_product" not in data:
        drive.error = failure_text(data, proc)
        return drive
    drive.model = (
        data.get("model_name") or " ".join(filter(None, [data.get("scsi_vendor"), data.get("scsi_product")])) or ""
    )
    drive.serial = data.get("serial_number", "")
    drive.size = get(data, "user_capacity", "bytes", default=0) or get(data, "nvme_total_capacity", default=0)
    passed = get(data, "smart_status", "passed")
    drive.health = None if passed is None else ("PASSED" if passed else "FAILED")
    return drive


def scan_drives() -> list[Drive]:
    """Discover drives with ``smartctl --scan`` and summarise each one.

    Returns
    -------
    list of Drive
        Discovered drives with their summaries filled in.

    Raises
    ------
    RuntimeError
        If the scan produced no parseable output.
    """
    data, proc = smartctl_json(["--scan"], timeout=60)
    if data is None:
        raise RuntimeError(failure_text(data, proc))
    drives = [Drive(d["name"], d.get("type")) for d in data.get("devices", [])]
    with ThreadPoolExecutor(max_workers=8) as pool:
        return list(pool.map(fill_summary, drives))


def fetch_drive(drive: Drive) -> DriveData:
    """Fetch everything smartctl knows about a drive (``-x``) as JSON.

    Parameters
    ----------
    drive : Drive
        Drive to query.

    Returns
    -------
    DriveData
        The parsed data, or an error description.
    """
    try:
        data, proc = smartctl_json(["-x"] + drive.args())
    except (OSError, subprocess.SubprocessError) as exc:
        return DriveData(error=str(exc))
    if data is None:
        return DriveData(error=failure_text(data, proc))
    return DriveData(json=data)


def fetch_raw(drive: Drive) -> str:
    """Return the plain-text ``smartctl -x`` report for a drive.

    Parameters
    ----------
    drive : Drive
        Drive to query.

    Returns
    -------
    str
        smartctl's stdout, or its stderr if stdout is empty.
    """
    proc = subprocess.run(
        SMARTCTL_CMD + ["-x"] + drive.args(), capture_output=True, text=True, timeout=FETCH_TIMEOUT, check=False
    )
    return proc.stdout or proc.stderr


def run_action(drive: Drive, args: list[str]) -> tuple[bool, str]:
    """Run a state-changing smartctl command.

    Parameters
    ----------
    drive : Drive
        Drive to act on.
    args : list of str
        smartctl arguments describing the action (without the device).

    Returns
    -------
    ok : bool
        Whether the command succeeded.
    message : str
        Informational or error message.
    """
    try:
        data, proc = smartctl_json(args + drive.args(), timeout=60)
    except (OSError, subprocess.SubprocessError) as exc:
        return False, str(exc)
    msgs = messages_of(data) if data else []
    # Exit-status bits 0-2 mean the command itself failed.
    ok = data is not None and proc.returncode & 0b111 == 0
    if not ok:
        return False, failure_text(data, proc)
    text = next((m for m in msgs if "wait" in m.lower() or "started" in m.lower()), "")
    if not text and data is not None:
        text = "Command completed"
    return True, text



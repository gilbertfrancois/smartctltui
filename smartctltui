class Job:
    """A function running in a worker thread, polled by the UI loop.

    Parameters
    ----------
    message : str
        Status text shown while the job runs.
    func : callable
        Function to run in the worker thread.
    on_done : callable, optional
        Called with the job once it has finished.
    blocking : bool, optional
        Whether the caller waits for the job itself.

    Attributes
    ----------
    result : object
        Return value of ``func``.
    error : Exception or None
        Exception raised by ``func``, if any.
    done : bool
        Whether the job has finished.
    """

    def __init__(
        self,
        message: str,
        func: Callable[[], Any],
        on_done: Callable[["Job"], None] | None = None,
        blocking: bool = False,
    ) -> None:
        self.message, self.on_done, self.blocking = message, on_done, blocking
        self.result = self.error = None
        self.done = False
        threading.Thread(target=self._run, args=(func,), daemon=True).start()

    def _run(self, func: Callable[[], Any]) -> None:
        try:
            self.result = func()
        except Exception as exc:  # pylint: disable=broad-exception-caught
            self.error = exc
        finally:
            self.done = True


@dataclass
class AppState:
    """Everything the UI needs between frames.

    Attributes
    ----------
    out_dir : pathlib.Path
        Default directory for saved reports.
    drives : list of Drive
        Known drives.
    sel : int
        Selected row in the drive list.
    top : int
        First visible row in the drive list.
    view : str
        Current view, ``"drives"`` or ``"drive"``.
    drive : Drive or None
        Drive open in the tabbed view.
    data : DriveData or None
        Loaded data for ``drive``.
    raw : str or None
        Raw ``smartctl -x`` text, once loaded.
    tab : int
        Index of the current tab.
    scroll : dict
        Scroll offset per tab index.
    status : str
        Transient status message.
    status_style : str or None
        Style of the status message.
    status_time : float
        Unix timestamp when the status was set.
    job : Job or None
        Running background job.
    pending_g : bool
        Whether a first ``g`` of a ``gg`` sequence was pressed.
    body_height : int
        Visible body rows of the drive view.
    cache_key : tuple
        Key identifying the cached display lines.
    cache_lines : list
        Cached display lines.
    """

    out_dir: Path
    drives: list = field(default_factory=list)
    sel: int = 0
    top: int = 0
    view: str = "drives"
    drive: Drive | None = None
    data: DriveData | None = None
    raw: str | None = None
    tab: int = 0
    scroll: dict = field(default_factory=dict)
    status: str = ""
    status_style: str | None = None
    status_time: float = 0.0
    job: Job | None = None
    pending_g: bool = False
    body_height: int = 10
    cache_key: tuple = ()
    cache_lines: list = field(default_factory=list)

    def set_status(self, text: str, style: str | None = None) -> None:
        """Show a transient message in the status line.

        Parameters
        ----------
        text : str
            Message to show.
        style : str or None, optional
            Style name for the message.
        """
        self.status, self.status_style, self.status_time = text, style, time.time()

    def lines(self, width: int) -> Lines:
        """Return (cached) display lines for the current tab.

        Parameters
        ----------
        width : int
            Available text width.

        Returns
        -------
        list of tuple
            ``(style, text)`` display lines.
        """
        key = (self.tab, width, id(self.data), id(self.raw), self.drive.name if self.drive else None)
        if key != self.cache_key:
            if self.tab == RAW_TAB:
                built = build_raw(self.raw, width)
            elif self.data is None:
                built = [("dim", "Loading...")]
            elif self.data.json is None:
                built = [("bad", f"Could not read this drive: {self.data.error}")]
                if os.geteuid() != 0 and not os.environ.get("SMARTCTLTUI_SMARTCTL"):
                    built.append(("warn", "Not running as root - smartctl normally needs root to access drives."))
            else:
                built = BUILDERS[self.tab](self.data.json, width)
            self.cache_key, self.cache_lines = key, built
        return self.cache_lines

    def test_running(self) -> bool:
        """Check whether the drive reports a self-test in progress.

        Returns
        -------
        bool
            True if a self-test is running.
        """
        d = self.data.json if self.data and self.data.json else {}
        if get(d, "ata_smart_data", "self_test", "status", "remaining_percent") is not None:
            return True
        return bool(get(d, "nvme_self_test_log", "current_self_test_operation", "value", default=0))


def start_refresh(st: AppState, quiet: bool = False) -> None:
    """Begin a non-blocking reload of the current drive's data.

    The raw text is reloaded too if it was already loaded.

    Parameters
    ----------
    st : AppState
        Application state.
    quiet : bool, optional
        Suppress the "Refreshed" status message.
    """
    if st.job or not st.drive:
        return
    drive, want_raw = st.drive, st.raw is not None or st.tab == RAW_TAB

    def work() -> tuple[DriveData, str | None]:
        return fetch_drive(drive), (fetch_raw(drive) if want_raw else None)

    def done(job: Job) -> None:
        if st.drive is not drive:
            return
        if job.error:
            st.set_status(f"Refresh failed: {job.error}", "bad")
            return
        st.data, raw = job.result
        if raw is not None:
            st.raw = raw
        if not quiet:
            st.set_status("Refreshed", "good")

    st.job = Job(f"Reading {drive.name}", work, done)


def run_blocking(
    stdscr: curses.window, st: AppState, message: str, func: Callable[[], Any]
) -> tuple[Any, Exception | None]:
    """Run a function in a thread while animating a spinner.

    Parameters
    ----------
    stdscr : curses.window
        Main window.
    st : AppState
        Application state.
    message : str
        Status text shown beside the spinner.
    func : callable
        Function to run.

    Returns
    -------
    result : object
        Return value of ``func``, or None on error.
    error : Exception or None
        Exception raised by ``func``, if any.
    """
    job = Job(message, func, blocking=True)
    st.job = job
    while not job.done:
        draw(stdscr, st)
        stdscr.timeout(100)
        stdscr.getch()
    st.job = None
    curses.flushinp()
    return job.result, job.error


def tick(st: AppState) -> None:
    """Do per-frame housekeeping: finish jobs, expire status, auto-poll running tests.

    Parameters
    ----------
    st : AppState
        Application state.
    """
    if st.job and st.job.done and not st.job.blocking:
        job, st.job = st.job, None
        if job.on_done:
            job.on_done(job)
    if st.status and time.time() - st.status_time > STATUS_TTL:
        st.status = ""
    if (
        st.view == "drive"
        and not st.job
        and st.data
        and st.test_running()
        and time.time() - st.data.fetched > POLL_SECONDS
    ):
        start_refresh(st, quiet=True)



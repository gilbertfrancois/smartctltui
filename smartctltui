def get(obj: Any, *path: str | int, default: Any = None) -> Any:
    """Safely walk nested dicts/lists.

    Parameters
    ----------
    obj : object
        Structure to traverse.
    *path : str or int
        Keys (for dicts) or indices (for lists) to follow in order.
    default : object, optional
        Value returned if any step is missing or None.

    Returns
    -------
    object
        The value at ``path``, or ``default``.
    """
    for key in path:
        if isinstance(obj, dict):
            obj = obj.get(key)
        elif isinstance(obj, list) and isinstance(key, int) and -len(obj) <= key < len(obj):
            obj = obj[key]
        else:
            return default
        if obj is None:
            return default
    return obj


def human_bytes(n: int | float) -> str:
    """Format a byte count with decimal units, like smartctl does.

    Parameters
    ----------
    n : int or float
        Number of bytes.

    Returns
    -------
    str
        Formatted size, e.g. ``"1.00 TB"``.
    """
    n = float(n)
    for unit in ("B", "kB", "MB", "GB", "TB", "PB"):
        if n < 1000 or unit == "PB":
            return f"{n:.0f} B" if unit == "B" else f"{n:.2f} {unit}"
        n /= 1000
    return ""


def fmt_hours(hours: int | float) -> str:
    """Format power-on hours as ``12,345 h (1y 15d 9h)``.

    Parameters
    ----------
    hours : int or float
        Number of hours.

    Returns
    -------
    str
        Formatted duration.
    """
    hours = int(hours)
    days, hrs = divmod(hours, 24)
    years, days = divmod(days, 365)
    parts = ([f"{years}y"] if years else []) + ([f"{days}d"] if days or years else []) + [f"{hrs}h"]
    return f"{hours:,} h ({' '.join(parts)})"


def fmt_scalar(value: Any) -> str:
    """Render a JSON scalar for display.

    Parameters
    ----------
    value : object
        Scalar value (None, bool, or anything printable).

    Returns
    -------
    str
        Display text.
    """
    if value is None:
        return "-"
    if isinstance(value, bool):
        return "yes" if value else "no"
    return str(value)


def flatten(obj: Any, prefix: str = "") -> list[tuple[str, str]]:
    """Flatten nested JSON to ``(dotted.key, text)`` pairs.

    Dicts of the form ``{value, string}`` collapse to the string.

    Parameters
    ----------
    obj : object
        JSON-like structure to flatten.
    prefix : str, optional
        Key prefix for the current level.

    Returns
    -------
    list of tuple of str
        ``(dotted.key, text)`` pairs.
    """
    out = []
    if isinstance(obj, dict):
        if "string" in obj and len(obj) <= 3:
            out.append((prefix, fmt_scalar(obj["string"])))
            return out
        for key, val in obj.items():
            out += flatten(val, f"{prefix}.{key}" if prefix else str(key))
    elif isinstance(obj, list):
        if all(not isinstance(x, (dict, list)) for x in obj):
            out.append((prefix, ", ".join(map(fmt_scalar, obj)) if len(obj) <= 24 else f"{len(obj)} values"))
        else:
            for i, item in enumerate(obj):
                out += flatten(item, f"{prefix}[{i}]")
    else:
        out.append((prefix, fmt_scalar(obj)))
    return out


def section(lines: Lines, title: str) -> None:
    """Start a titled section, separated from the previous one by a blank line.

    Parameters
    ----------
    lines : list of tuple
        Output ``(style, text)`` lines, appended to in place.
    title : str
        Section heading.
    """
    if lines:
        lines.append((None, ""))
    lines.append(("head", title))


def kv(lines: Lines, key: str, value: Any, style: str | None = None, width: int = 28) -> None:
    """Append a ``key: value`` row unless the value is missing.

    Parameters
    ----------
    lines : list of tuple
        Output ``(style, text)`` lines, appended to in place.
    key : str
        Row label.
    value : object
        Row value; None or an empty string skips the row.
    style : str or None, optional
        Style name for the row.
    width : int, optional
        Width of the label column.
    """
    if value is None or value == "":
        return
    lines.append((style, f"{key + ':':<{width}} {value}"))


def kv_flat(lines: Lines, obj: Any, width: int = 34, indent: str = "") -> None:
    """Append every leaf of ``obj`` as an aligned key/value row.

    Parameters
    ----------
    lines : list of tuple
        Output ``(style, text)`` lines, appended to in place.
    obj : object
        JSON-like structure to flatten.
    width : int, optional
        Width of the label column.
    indent : str, optional
        Prefix placed before each row.
    """
    for key, val in flatten(obj):
        lines.append((None, f"{indent}{key + ':':<{width}} {val}"))


def fmt_table(headers: list[str], rows: list[tuple], aligns: list[str] | None = None) -> tuple[str, list[str]]:
    """Align a table.

    Parameters
    ----------
    headers : list of str
        Column headers.
    rows : list of tuple
        Table rows; cells are converted with ``str``.
    aligns : list of str, optional
        Per-column alignment, ``"r"`` for right, anything else for left.

    Returns
    -------
    header : str
        Formatted header line.
    body : list of str
        Formatted row lines.
    """
    widths = [max(len(str(r[i])) for r in [headers] + rows) for i in range(len(headers))]

    def fmt(row: Iterable[Any]) -> str:
        cells = [
            str(c).rjust(widths[i]) if aligns and aligns[i] == "r" else str(c).ljust(widths[i])
            for i, c in enumerate(row)
        ]
        return "  ".join(cells).rstrip()

    return fmt(headers), [fmt(r) for r in rows]


def not_available(lines: Lines, what: str = "Not available for this drive.") -> None:
    """Append a dimmed placeholder row.

    Parameters
    ----------
    lines : list of tuple
        Output ``(style, text)`` lines, appended to in place.
    what : str, optional
        Placeholder text.
    """
    lines.append(("dim", what))


def is_nvme(d: dict) -> bool:
    """Check whether the JSON describes an NVMe device.

    Parameters
    ----------
    d : dict
        Parsed smartctl JSON.

    Returns
    -------
    bool
        True for NVMe devices.
    """
    return get(d, "device", "protocol") == "NVMe" or "nvme_smart_health_information_log" in d


def is_ata(d: dict) -> bool:
    """Check whether the JSON describes an ATA/SATA device.

    Parameters
    ----------
    d : dict
        Parsed smartctl JSON.

    Returns
    -------
    bool
        True for ATA devices.
    """
    return "ata_smart_attributes" in d or get(d, "device", "protocol") == "ATA"


# --------------------------------------------------------------------------
# Tab content builders. Each returns a list of (style, text) lines.
# --------------------------------------------------------------------------


def build_general(d: dict, _width: int) -> Lines:
    """Build the General tab: health verdict plus identity, capabilities and usage.

    Parameters
    ----------
    d : dict
        Parsed smartctl JSON.
    _width : int
        Available text width (unused).

    Returns
    -------
    list of tuple
        ``(style, text)`` display lines.
    """
    lines = []
    passed = get(d, "smart_status", "passed")
    section(lines, "Overall health")
    if passed is None:
        lines.append(("warn", "SMART health status: unknown"))
    elif passed:
        lines.append(("good", "SMART overall-health self-assessment: PASSED"))
    else:
        lines.append(("bad", "SMART overall-health self-assessment: FAILED!"))
    status = get(d, "smartctl", "exit_status", default=0)
    for bit, (style, text) in EXIT_BITS.items():
        if status & (1 << bit):
            lines.append((style, f"! {text}"))
    for msg in messages_of(d):
        lines.append(("warn", f"smartctl: {msg}"))

    section(lines, "Device")
    kv(lines, "Model family", d.get("model_family"))
    kv(lines, "Model", d.get("model_name") or " ".join(filter(None, [d.get("scsi_vendor"), d.get("scsi_product")])))
    kv(lines, "Serial number", d.get("serial_number"))
    wwn = d.get("wwn")
    if wwn:
        kv(lines, "WWN", f"{wwn.get('naa', '')} {wwn.get('oui', 0):06x} {wwn.get('id', 0):09x}")
    kv(lines, "Firmware version", d.get("firmware_version") or d.get("scsi_revision"))
    cap = get(d, "user_capacity", "bytes")
    if cap:
        kv(lines, "Capacity", f"{human_bytes(cap)} ({cap:,} bytes)")
    kv(lines, "NVMe total capacity", human_bytes(d["nvme_total_capacity"]) if d.get("nvme_total_capacity") else None)
    kv(
        lines,
        "NVMe unallocated",
        human_bytes(d["nvme_unallocated_capacity"]) if d.get("nvme_unallocated_capacity") is not None else None,
    )
    kv(lines, "Logical sector size", get(d, "logical_block_size"))
    kv(lines, "Physical sector size", get(d, "physical_block_size"))
    rot = d.get("rotation_rate")
    if rot is not None:
        kv(lines, "Rotation rate", "Solid state device" if rot == 0 else f"{rot} rpm")
    kv(lines, "Form factor", get(d, "form_factor", "name"))
    kv(lines, "Device node", get(d, "device", "name"))
    kv(
        lines,
        "Protocol / type",
        f"{get(d, 'device', 'protocol', default='?')} / {get(d, 'device', 'type', default='?')}",
    )
    kv(lines, "ATA version", get(d, "ata_version", "string"))
    kv(lines, "SATA version", get(d, "sata_version", "string"))
    kv(lines, "Interface speed", get(d, "interface_speed", "current", "string"))
    kv(lines, "TRIM supported", fmt_scalar(get(d, "trim", "supported")) if get(d, "trim") else None)
    kv(lines, "NVMe version", get(d, "nvme_version", "string"))
    kv(lines, "NVMe controller ID", d.get("nvme_controller_id"))
    kv(lines, "NVMe namespaces", d.get("nvme_number_of_namespaces"))
    kv(lines, "In smartctl database", fmt_scalar(d["in_smartctl_database"]) if "in_smartctl_database" in d else None)

    section(lines, "SMART support")
    avail, enabled = get(d, "smart_support", "available"), get(d, "smart_support", "enabled")
    kv(lines, "SMART available", fmt_scalar(avail) if avail is not None else None)
    kv(
        lines,
        "SMART enabled",
        fmt_scalar(enabled) if enabled is not None else None,
        None if enabled in (None, True) else "warn",
    )

    section(lines, "Usage")
    poh = get(d, "power_on_time", "hours")
    kv(lines, "Power-on time", fmt_hours(poh) if poh is not None else None)
    kv(lines, "Power cycles", d.get("power_cycle_count"))
    temp = get(d, "temperature", "current")
    kv(lines, "Temperature", f"{temp} °C" if temp is not None else None)
    used = get(d, "endurance_used", "current_percent")
    kv(lines, "Endurance used", f"{used} %" if used is not None else None)
    return lines


def attr_style(attr: dict) -> str | None:
    """Choose a display style for an ATA attribute row.

    Parameters
    ----------
    attr : dict
        One entry of the ATA attribute table.

    Returns
    -------
    str or None
        Style name, or None for the default style.
    """
    failed = attr.get("when_failed") or ""
    if failed == "now":
        return "bad"
    if failed:
        return "warn"
    thresh = attr.get("thresh") or 0
    if thresh and attr.get("value", 255) <= thresh:
        return "bad"
    return None


def build_attributes(d: dict, _width: int) -> Lines:
    """Build the Attributes tab: ATA attribute table, NVMe health log, or SCSI logs.

    Parameters
    ----------
    d : dict
        Parsed smartctl JSON.
    _width : int
        Available text width (unused).

    Returns
    -------
    list of tuple
        ``(style, text)`` display lines.
    """
    lines = []
    table = get(d, "ata_smart_attributes", "table")
    if table:
        rows = []
        for a in table:
            rows.append(
                (
                    a.get("id"),
                    a.get("name"),
                    a.get("value"),
                    a.get("worst"),
                    a.get("thresh"),
                    get(a, "raw", "string", default=get(a, "raw", "value", default="")),
                    "Pre-fail" if get(a, "flags", "prefailure") else "Old_age",
                    "Always" if get(a, "flags", "updated_online") else "Offline",
                    a.get("when_failed") or "-",
                )
            )
        head, body = fmt_table(
            ["ID", "ATTRIBUTE", "VAL", "WORST", "THR", "RAW VALUE", "TYPE", "UPDATED", "FAILED"],
            rows,
            ["r", "l", "r", "r", "r", "l", "l", "l", "l"],
        )
        lines.append(("head", head))
        for text, attr in zip(body, table):
            lines.append((attr_style(attr), text))
        lines += [
            (None, ""),
            ("dim", "Pre-fail attributes at/below THR indicate imminent failure; VAL/WORST are normalised."),
        ]
        return lines
    log = d.get("nvme_smart_health_information_log")
    if log:
        section(lines, "NVMe SMART / Health Information")
        warn = log.get("critical_warning", 0)
        for key, val in flatten(log):
            style = None
            if key == "critical_warning" and warn:
                style = "bad"
            elif key == "media_errors" and val not in ("0", "-"):
                style = "bad"
            elif key == "percentage_used" and val.isdigit() and int(val) >= 90:
                style = "bad"
            elif key == "available_spare" and val.isdigit() and int(val) <= log.get("available_spare_threshold", 0):
                style = "bad"
            lines.append((style, f"{key + ':':<28} {val}"))
        return lines
    scsi = {k: v for k, v in d.items() if k.startswith("scsi_") and k not in SCSI_IDENTITY}
    if scsi:
        kv_flat(lines, scsi)
        return lines
    not_available(lines, "No SMART attributes reported by this drive.")
    return lines


SCSI_IDENTITY = {"scsi_vendor", "scsi_product", "scsi_model_name", "scsi_revision", "scsi_version"}


def build_statistics(d: dict, _width: int) -> Lines:
    """Build the Statistics tab: ATA device statistics pages, or derived NVMe usage figures.

    Parameters
    ----------
    d : dict
        Parsed smartctl JSON.
    _width : int
        Available text width (unused).

    Returns
    -------
    list of tuple
        ``(style, text)`` display lines.
    """
    lines = []
    pages = get(d, "ata_device_statistics", "pages")
    if pages:
        for page in pages:
            section(lines, page.get("name", f"Page {page.get('number')}"))
            for entry in page.get("table", []):
                valid = get(entry, "flags", "valid", default=True)
                val = entry.get("value") if valid else "n/a"
                lines.append((None if valid else "dim", f"  {entry.get('name', '?') + ':':<40} {val}"))
        return lines
    log = d.get("nvme_smart_health_information_log")
    if log:
        unit = 512_000  # an NVMe "data unit" is 1000 * 512 bytes
        section(lines, "Data transferred")
        for label, key in (("Data read", "data_units_read"), ("Data written", "data_units_written")):
            if key in log:
                lines.append((None, f"  {label + ':':<28} {human_bytes(log[key] * unit)}"))
        for label, key in (("Host read commands", "host_reads"), ("Host write commands", "host_writes")):
            if key in log:
                lines.append((None, f"  {label + ':':<28} {log[key]:,}"))
        section(lines, "Wear and reliability")
        for label, key, suffix in (
            ("Percentage used", "percentage_used", " %"),
            ("Available spare", "available_spare", " %"),
            ("Available spare threshold", "available_spare_threshold", " %"),
            ("Media and data integrity errors", "media_errors", ""),
            ("Error log entries", "num_err_log_entries", ""),
            ("Unsafe shutdowns", "unsafe_shutdowns", ""),
        ):
            if key in log:
                lines.append((None, f"  {label + ':':<34} {log[key]:,}{suffix}"))
        section(lines, "Time")
        for label, key, suffix in (
            ("Power-on hours", "power_on_hours", " h"),
            ("Power cycles", "power_cycles", ""),
            ("Controller busy time", "controller_busy_time", " min"),
            ("Time above warning temp", "warning_temp_time", " min"),
            ("Time above critical temp", "critical_comp_time", " min"),
        ):
            if key in log:
                lines.append((None, f"  {label + ':':<34} {log[key]:,}{suffix}"))
        return lines
    not_available(lines, "No device statistics reported by this drive.")
    return lines


def self_test_style(passed: bool | None, text: str) -> str:
    """Style a self-test result row.

    Parameters
    ----------
    passed : bool or None
        The ``passed`` flag from smartctl, if reported.
    text : str
        Result description.

    Returns
    -------
    str
        Style name: ``"good"``, ``"warn"`` or ``"bad"``.
    """
    if passed is True or text.lower().startswith("completed without"):
        return "good"
    if re.search(r"abort|interrupt|reset", text, re.I):
        return "warn"
    return "bad"


def build_selftests(d: dict, _width: int) -> Lines:
    """Build the Self-Tests tab: current progress, expected durations, and the test log.

    Parameters
    ----------
    d : dict
        Parsed smartctl JSON.
    _width : int
        Available text width (unused).

    Returns
    -------
    list of tuple
        ``(style, text)`` display lines.
    """
    lines = []
    status = get(d, "ata_smart_data", "self_test", "status")
    if status:
        section(lines, "Current status")
        pct = status.get("remaining_percent")
        if pct is not None:
            lines.append(("warn", f"Self-test in progress: {100 - pct}% done ({pct}% remaining)"))
        else:
            lines.append((None, status.get("string", "unknown")))
        poll = get(d, "ata_smart_data", "self_test", "polling_minutes")
        if poll:
            section(lines, "Estimated duration")
            for key, label in (("short", "Short"), ("extended", "Extended"), ("conveyance", "Conveyance")):
                if key in poll:
                    lines.append((None, f"  {label + ':':<14} {poll[key]} min"))
    nv = d.get("nvme_self_test_log")
    if nv:
        section(lines, "Current status")
        op = get(nv, "current_self_test_operation", "string", default="No self-test in progress")
        pct = nv.get("current_self_test_completion_percent")
        lines.append(
            (
                "warn" if get(nv, "current_self_test_operation", "value", default=0) else None,
                f"{op}" + (f" ({pct}% complete)" if pct else ""),
            )
        )

    rows, styles = [], []
    ata = d.get("ata_smart_self_test_log")
    if ata:
        log = ata.get("extended") or ata.get("standard") or {}
        for i, e in enumerate(log.get("table", []), 1):
            res = get(e, "status", "string", default="?")
            rows.append(
                (f"# {i}", get(e, "type", "string", default="?"), res, e.get("lifetime_hours", "-"), e.get("lba", "-"))
            )
            styles.append(self_test_style(get(e, "status", "passed"), res))
    if nv:
        for i, e in enumerate(nv.get("table", []), 1):
            res = get(e, "self_test_result", "string", default="?")
            rows.append(
                (
                    f"# {i}",
                    get(e, "self_test_code", "string", default="?"),
                    res,
                    e.get("power_on_hours", "-"),
                    e.get("lba", "-"),
                )
            )
            styles.append(self_test_style(None, res))
    section(lines, "Self-test log (newest first)")
    if rows:
        head, body = fmt_table(
            ["NUM", "TEST", "RESULT", "POWER-ON H", "LBA OF 1ST ERROR"], rows, ["r", "l", "l", "r", "r"]
        )
        lines.append(("dim", head))
        lines += list(zip(styles, body))
    elif ata or nv:
        not_available(lines, "No self-tests have been logged.")
    else:
        not_available(lines, "Self-test log not supported by this drive.")
    return lines


def build_errors(d: dict, _width: int) -> Lines:
    """Build the Error Log tab: ATA error log entries or the NVMe error information log.

    Parameters
    ----------
    d : dict
        Parsed smartctl JSON.
    _width : int
        Available text width (unused).

    Returns
    -------
    list of tuple
        ``(style, text)`` display lines.
    """
    lines = []
    ata = d.get("ata_smart_error_log")
    if ata:
        log = ata.get("extended") or ata.get("summary") or {}
        count = log.get("count", 0)
        section(lines, "ATA error log")
        lines.append(("bad" if count else "good", f"Errors logged: {count}" if count else "No errors logged"))
        for e in log.get("table", []):
            section(lines, f"Error {e.get('error_number', '?')} at {e.get('lifetime_hours', '?')} h of power-on time")
            rest = {k: v for k, v in e.items() if k not in ("error_number", "lifetime_hours", "previous_commands")}
            kv_flat(lines, rest, indent="  ")
            for cmd in e.get("previous_commands", []):
                name = cmd.get("command_name") or get(cmd, "registers", "command", default="?")
                lines.append(("dim", f"    preceding command: {name} @ {cmd.get('powerup_milliseconds', '?')} ms"))
    nv = d.get("nvme_error_information_log")
    if nv:
        section(lines, "NVMe error information log")
        table = nv.get("table", [])
        lines.append(
            ("bad" if nv.get("unread") else None, f"Entries read: {nv.get('read', 0)}, unread: {nv.get('unread', 0)}")
        )
        for e in table:
            section(lines, f"Error count {e.get('error_count', '?')}")
            kv_flat(lines, e, indent="  ")
        if not table:
            lines.append(("good", "No errors logged"))
    if not lines:
        not_available(lines, "Error log not supported by this drive.")
    return lines


def chart_rows(values: list[float], width: int, height: int = 8) -> tuple[list[str], float, float]:
    """Render values as a filled bar chart.

    Parameters
    ----------
    values : list of float
        Data points, oldest first.
    width : int
        Maximum number of chart columns.
    height : int, optional
        Number of text rows.

    Returns
    -------
    rows : list of str
        Chart rows, top to bottom.
    lo : float
        Minimum value.
    hi : float
        Maximum value.
    """
    lo, hi = min(values), max(values)
    span = max(hi - lo, 1)
    cols = []
    n = len(values)
    for c in range(min(width, n)):
        chunk = values[c * n // min(width, n) : max((c + 1) * n // min(width, n), c * n // min(width, n) + 1)]
        cols.append(sum(chunk) / len(chunk))
    levels = [1 + round((v - lo) / span * (height * 8 - 1)) for v in cols]
    steps = len(BLOCKS) - 1
    rows = []
    for r in range(height - 1, -1, -1):
        row = ""
        for lv in levels:
            eighths = max(0, min(8, lv - r * 8))
            row += BLOCKS[round(eighths * steps / 8)]
        rows.append(row)
    return rows, lo, hi


def build_temperature(d: dict, width: int) -> Lines:
    """Build the Temperature tab: current readings, limits and the SCT history chart.

    Parameters
    ----------
    d : dict
        Parsed smartctl JSON.
    width : int
        Available text width.

    Returns
    -------
    list of tuple
        ``(style, text)`` display lines.
    """
    lines = []
    temp = get(d, "temperature", "current")
    section(lines, "Current")
    kv(lines, "Temperature", f"{temp} °C" if temp is not None else None)
    for key, label in (("op_limit_max", "Warning threshold"), ("critical_limit_max", "Critical threshold")):
        if get(d, "temperature", key) is not None and not is_ata(d):
            kv(lines, label, f"{d['temperature'][key]} °C")
    sct = get(d, "ata_sct_status", "temperature")
    if sct:
        for key, label in (
            ("lifetime_min", "Lifetime minimum"),
            ("lifetime_max", "Lifetime maximum"),
            ("power_cycle_min", "Power cycle minimum"),
            ("power_cycle_max", "Power cycle maximum"),
            ("op_limit_max", "Operating limit (max)"),
            ("limit_max", "Max limit"),
            ("limit_min", "Min limit"),
            ("under_over_limit_count", "Times over/under limit"),
        ):
            if key in sct:
                kv(lines, label, f"{sct[key]}" + ("" if key.endswith("count") else " °C"))
    log = d.get("nvme_smart_health_information_log")
    if log:
        for i, t in enumerate(log.get("temperature_sensors", []), 1):
            kv(lines, f"Sensor {i}", f"{t} °C")
        kv(lines, "Minutes above warning temp", log.get("warning_temp_time"))
        kv(lines, "Minutes above critical temp", log.get("critical_comp_time"))
    hist = d.get("ata_sct_temperature_history")
    if hist and hist.get("table"):
        table, idx = hist["table"], hist.get("index", 0)
        ordered = table[idx + 1 :] + table[: idx + 1] if 0 <= idx < len(table) else table
        values = [v for v in ordered if isinstance(v, (int, float)) and -100 < v < 200]
        period = hist.get("logging_interval_minutes", hist.get("sampling_period_minutes", "?"))
        section(lines, f"Temperature history ({len(values)} samples, one per {period} min, oldest at left)")
        if values:
            rows, lo, hi = chart_rows(values, max(10, width - 8))
            for i, row in enumerate(rows):
                label = f"{hi:>3.0f} " if i == 0 else (f"{lo:>3.0f} " if i == len(rows) - 1 else "    ")
                lines.append((None, label + row))
            lines.append(
                ("dim", f"    min {min(values)} °C   max {max(values)} °C   avg {sum(values) / len(values):.1f} °C")
            )
    elif not log and not sct:
        not_available(lines, "No SCT temperature log available for this drive.")
    return lines



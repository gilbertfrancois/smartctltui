def supports_unicode() -> bool:
    """Check whether the terminal can render box-drawing characters.

    Returns
    -------
    bool
        True when the locale encoding is a UTF variant.
    """
    return "utf" in (locale.getpreferredencoding(False) or "").lower()


def setup_glyphs() -> None:
    """Switch to Unicode box/block glyphs if the terminal can show them.

    Modifies the module-level glyph constants in place.
    """
    global BOX_TL, BOX_TR, BOX_BL, BOX_BR, BOX_H, BOX_V, BLOCKS, SPINNER
    if supports_unicode():
        BOX_TL, BOX_TR, BOX_BL, BOX_BR, BOX_H, BOX_V = "╭", "╮", "╰", "╯", "─", "│"
        BLOCKS = " ▁▂▃▄▅▆▇█"
        SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"


